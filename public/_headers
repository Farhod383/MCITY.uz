# Cloudflare Pages / Netlify uchun HTTP sarlavhalari
# (Boshqa hostingda bu fayl e'tiborsiz qoladi — zarari yo'q)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite hashlangan fayllar — abadiy keshlanadi (LCP va takroriy tashrif uchun)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Boshqaruv paneli qidiruv tizimlariga chiqmasin
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
