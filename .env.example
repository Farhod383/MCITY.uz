# Supabase ulanish kalitlari.
# Lovable'da "Supabase -> Connect" bosilganda bular avtomatik qo'shiladi.
# Bu qiymatlar brauzerga ham tushadi — shuning uchun bu yerga faqat
# ANON (publishable) kalit yoziladi. SERVICE_ROLE kalitni HECH QACHON
# bu faylga yozmang.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sayt manzili (production). Lokal ishlashda http://localhost:5173
VITE_SITE_URL=https://mcity.uz

# Server tomonda www -> apex yo'naltirish uchun (VITE_ prefiksisiz)
CANONICAL_HOST=mcity.uz
